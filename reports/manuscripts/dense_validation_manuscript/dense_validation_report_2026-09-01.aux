\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Esdale gridded prediction overview for the observed driest (21~May~2025; mean observed soil moisture 7.0\,\%) and wettest (11~July~2025; 23.2\,\%) dense-campaign dates. Columns show the coarse SMIPS estimate, model~6 RF{} and model~8 process{}. Mean predicted soil moisture across validation supports was 14.8\,\% and 15.5\,\% on the dry date, and 20.3\,\% and 24.8\,\% on the wet date, for model~6 RF{} and model~8 process{} respectively.}}{7}{figure.2}\protected@file@percent }
\newlabel{fig:esdale-dry-wet}{{2}{7}{Esdale gridded prediction overview for the observed driest (21~May~2025; mean observed soil moisture 7.0\,\%) and wettest (11~July~2025; 23.2\,\%) dense-campaign dates. Columns show the coarse SMIPS estimate, \modelSix {} and \modelEight {}. Mean predicted soil moisture across validation supports was 14.8\,\% and 15.5\,\% on the dry date, and 20.3\,\% and 24.8\,\% on the wet date, for \modelSix {} and \modelEight {} respectively}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Tarrawarra gridded prediction overview for the observed driest (23~February~1996; mean observed soil moisture 20.3\,\%) and wettest (2~September~1996; 48.4\,\%) campaign dates after aggregation to model-grid support. Columns show the historical coarse estimate, model~6 RF{} and model~8 process{}. Mean predicted soil moisture across aggregated validation supports was 21.7\,\% and 23.4\,\% on the dry date, and 23.6\,\% and 31.6\,\% on the wet date, for model~6 RF{} and model~8 process{} respectively. \textcolor {cautioncolor}{[Caution: The historical \texttt  {SMIPS TotalBucket}{} input is affected by the zero-valued coarse-anchor caveat for this run.]}}}{8}{figure.3}\protected@file@percent }
\newlabel{fig:tarrawarra-dry-wet}{{3}{8}{Tarrawarra gridded prediction overview for the observed driest (23~February~1996; mean observed soil moisture 20.3\,\%) and wettest (2~September~1996; 48.4\,\%) campaign dates after aggregation to model-grid support. Columns show the historical coarse estimate, \modelSix {} and \modelEight {}. Mean predicted soil moisture across aggregated validation supports was 21.7\,\% and 23.4\,\% on the dry date, and 23.6\,\% and 31.6\,\% on the wet date, for \modelSix {} and \modelEight {} respectively. \caution {The historical \smips {} input is affected by the zero-valued coarse-anchor caveat for this run.}}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Nerrigundah gridded prediction overview for the observed driest (17~September~1997; mean observed soil moisture 22.1\,\%) and wettest (22~September~1997; 37.0\,\%) campaign dates after aggregation to model-grid support. Mean predicted soil moisture across aggregated validation supports was 23.9\,\% and 26.6\,\% on the dry date, and 24.9\,\% and 28.5\,\% on the wet date, for model~6 RF{} and model~8 process{} respectively.}}{9}{figure.4}\protected@file@percent }
\newlabel{fig:nerrigundah-dry-wet}{{4}{9}{Nerrigundah gridded prediction overview for the observed driest (17~September~1997; mean observed soil moisture 22.1\,\%) and wettest (22~September~1997; 37.0\,\%) campaign dates after aggregation to model-grid support. Mean predicted soil moisture across aggregated validation supports was 23.9\,\% and 26.6\,\% on the dry date, and 24.9\,\% and 28.5\,\% on the wet date, for \modelSix {} and \modelEight {} respectively}{figure.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Llara gridded prediction examples for the WE and WW paddocks, shown separately. In WE, the dry example is 6~November~2021 (mean observed 20.9\,\%; model~6 RF{} 26.7\,\%; model~8 process{} 25.5\,\%) and the wet example is 21~October~2022 (67.7\,\%; 34.3\,\%; 37.2\,\%). In WW, the dry example is 20~February~2022 (18.4\,\%; 26.4\,\%; 21.5\,\%) and the wet example is 21~October~2022 (57.8\,\%; 38.9\,\%; 35.8\,\%).}}{10}{figure.5}\protected@file@percent }
\newlabel{fig:llara-gridded}{{5}{10}{Llara gridded prediction examples for the WE and WW paddocks, shown separately. In WE, the dry example is 6~November~2021 (mean observed 20.9\,\%; \modelSix {} 26.7\,\%; \modelEight {} 25.5\,\%) and the wet example is 21~October~2022 (67.7\,\%; 34.3\,\%; 37.2\,\%). In WW, the dry example is 20~February~2022 (18.4\,\%; 26.4\,\%; 21.5\,\%) and the wet example is 21~October~2022 (57.8\,\%; 38.9\,\%; 35.8\,\%)}{figure.5}{}}
