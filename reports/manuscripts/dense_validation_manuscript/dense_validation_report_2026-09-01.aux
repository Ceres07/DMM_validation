\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces Prior-guided sparse local-calibration learning curves under strict spatial+temporal blocking. Each point is the best deployable non-random, non-proxy strategy/method combination for that site, model and local point budget. Positive values indicate lower RMSE after calibration.}}{20}{figure.13}\protected@file@percent }
\newlabel{fig:learning-curves-rmse}{{13}{20}{Prior-guided sparse local-calibration learning curves under strict spatial+temporal blocking. Each point is the best deployable non-random, non-proxy strategy/method combination for that site, model and local point budget. Positive values indicate lower RMSE after calibration}{figure.13}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {14}{\ignorespaces Prior-guided sparse local-calibration learning curves expressed as held-out \ensuremath  {\mathrm  {NSE}}{} under strict spatial+temporal blocking. Each point is selected using the same deployable non-random, non-proxy strategy set as Table~\ref {tab:min-budget}. Dashed and dotted reference lines mark \ensuremath  {\mathrm  {NSE}}{} = 0.2 and 0.3, respectively. These thresholds are not universal performance targets, but they are useful for asking how much local information is needed before calibration becomes meaningfully better than the uncalibrated baseline.}}{21}{figure.14}\protected@file@percent }
\newlabel{fig:learning-curves-nse}{{14}{21}{Prior-guided sparse local-calibration learning curves expressed as held-out \nse {} under strict spatial+temporal blocking. Each point is selected using the same deployable non-random, non-proxy strategy set as Table~\ref {tab:min-budget}. Dashed and dotted reference lines mark \nse {} = 0.2 and 0.3, respectively. These thresholds are not universal performance targets, but they are useful for asking how much local information is needed before calibration becomes meaningfully better than the uncalibrated baseline}{figure.14}{}}
