\newlabel{fig:timeseries}{{7}{12}{Observed and predicted soil-moisture time series by site. Values are spatial means over available validation points for each date. The MRI panel is scaled to 15--60\,\% soil moisture to keep the observed and predicted traces readable across the long probe record}{figure.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Seasonal bias by site and model. Residuals are prediction minus observation; positive values indicate overprediction. Esdale and Nerrigundah have limited seasonal coverage, while Llara and MRI provide the clearest multi-year seasonal bias diagnostics.}}{14}{figure.8}\protected@file@percent }
\newlabel{fig:seasonal-bias}{{8}{14}{Seasonal bias by site and model. Residuals are prediction minus observation; positive values indicate overprediction. Esdale and Nerrigundah have limited seasonal coverage, while Llara and MRI provide the clearest multi-year seasonal bias diagnostics}{figure.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Dry/wet observed-state bias. The driest and wettest observed quartiles test whether models compress extremes. The main diagnostic is whether predictions move toward the centre of the observed distribution, i.e. overpredicting dry supports and underpredicting wet supports.}}{15}{figure.9}\protected@file@percent }
\newlabel{fig:wetness-bias}{{9}{15}{Dry/wet observed-state bias. The driest and wettest observed quartiles test whether models compress extremes. The main diagnostic is whether predictions move toward the centre of the observed distribution, i.e. overpredicting dry supports and underpredicting wet supports}{figure.9}{}}
