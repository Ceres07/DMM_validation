\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Prior-guided sparse local-calibration learning curves under strict spatial+temporal blocking. Each point is the best deployable non-random, non-proxy strategy/method combination for that site, model and local point budget. Positive values indicate lower RMSE after calibration.}}{15}{figure.10}\protected@file@percent }
\newlabel{fig:learning-curves-rmse}{{10}{15}{Prior-guided sparse local-calibration learning curves under strict spatial+temporal blocking. Each point is the best deployable non-random, non-proxy strategy/method combination for that site, model and local point budget. Positive values indicate lower RMSE after calibration}{figure.10}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Prior-guided sparse local-calibration learning curves expressed as held-out \ensuremath  {\mathrm  {NSE}}{} under strict spatial+temporal blocking. Each point is selected using the same deployable non-random, non-proxy strategy set as Table~\ref {tab:min-budget}. Dashed and dotted reference lines mark \ensuremath  {\mathrm  {NSE}}{} = 0.2 and 0.3, respectively. These thresholds are not universal performance targets, but they are useful for asking how much local information is needed before calibration becomes meaningfully better than the uncalibrated baseline.}}{16}{figure.11}\protected@file@percent }
\newlabel{fig:learning-curves-nse}{{11}{16}{Prior-guided sparse local-calibration learning curves expressed as held-out \nse {} under strict spatial+temporal blocking. Each point is selected using the same deployable non-random, non-proxy strategy set as Table~\ref {tab:min-budget}. Dashed and dotted reference lines mark \nse {} = 0.2 and 0.3, respectively. These thresholds are not universal performance targets, but they are useful for asking how much local information is needed before calibration becomes meaningfully better than the uncalibrated baseline}{figure.11}{}}
